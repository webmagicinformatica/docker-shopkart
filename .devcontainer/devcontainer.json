{
  "name": "Docker: Zero to Pro · ShopKart",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "installDockerBuildx": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "ShopKart API" },
    "8080": { "label": "ShopKart web" }
  },
  "postCreateCommand": "pip install --quiet --disable-pip-version-check -r app/api/requirements-dev.txt",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "vscode"
}
